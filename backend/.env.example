# Kissan Drishti Backend Environment Variables Example

# Server listening port (Render and Cloud Run set this automatically)
PORT=8000

# Production CORS Allowed Origins
# Specify comma-separated URLs of your deployed frontend(s)
# Example: https://kissan-drishti.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=*

# Optional: Dedicated single frontend origin
FRONTEND_URL=
