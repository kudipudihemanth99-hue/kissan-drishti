# Kissan Drishti Frontend Environment Variables Template

# Production Backend API Base URL
# When deploying to Vercel or Netlify, set this environment variable to your deployed backend URL.
# Examples:
#   VITE_API_URL=https://kissan-drishti-backend.onrender.com
#   VITE_API_URL=https://kissan-drishti-xxxx-uc.a.run.app
#
# NOTE: Leave empty during local development so Vite automatically proxies '/api' to http://127.0.0.1:8000
VITE_API_URL=
